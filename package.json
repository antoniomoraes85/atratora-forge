{
  "name": "atratora-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plataforma de ferramentas inteligentes para automação de fluxos técnicos - Atratora Labs",
  "author": "José Antônio Coutinho de Moraes Filho <Atratora Labs>",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
